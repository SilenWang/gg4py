# .github/workflows/ci.yml
name: ci

on:
  pull_request:
    # SIL-835：PR 只对「改到 CI 会读的东西」的改动跑门禁。门禁内容（三个 job、
    # `pixi run check` 的依赖任务）一个字没动，收窄的只有触发范围。
    #
    # 排除项只有三类：`docs/**`（默认）、根目录 `*.md`、`LICENSE`。
    # 下面这些 docs 路径看似文档，实际被 CI 读取/校验，必须仍然触发：
    #   docs/cases/**                     案例三文件 + matrix.md，`cases:matrix:check` 与全部渲染门禁
    #   docs/spike/**                     度量语料 `corpus/labels_200.json`（gate:metrics）、
    #                                     E1/E2 实验脚本（gate:pyodide、tests 会读）
    #   docs/notes/snapshot-inventory.md  台账新鲜度（snapshots:report:check）+ tests
    #   docs/notes/api-coverage.md        API 覆盖率文档新鲜度（api:coverage:check）
    #   docs/notes/theme.md               theme 派生区块新鲜度（docs:theme:check）
    #   docs/notes/upstream.md            上游 pin，tests 校验 `- commit:` 行
    #   docs/notes/extension.md           文档里的代码块就是 doctest，tests 直接执行
    # 其余 docs/**（`docs/notes/` 的纯 prose、`docs/spike/**/report.md` 等）不触发；
    # `docs/notes/snapshot-tiers.md` 也在其中——`tiers:check` 只读 meta.toml 的档位声明，
    # 不读这份生成物（若将来给它加新鲜度门禁，记得把它加进例外）。
    paths:
      - "**"
      - "!docs/**"
      - "!*.md"
      - "!LICENSE"
      - "docs/cases/**"
      - "docs/spike/**"
      - "docs/notes/snapshot-inventory.md"
      - "docs/notes/api-coverage.md"
      - "docs/notes/theme.md"
      - "docs/notes/upstream.md"
      - "docs/notes/extension.md"
  push:
    branches: [main]
  workflow_dispatch:

concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: true

jobs:
  check:
    name: check (dev)
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v4
      - uses: prefix-dev/setup-pixi@v0.8.0
        with:
          environments: default
          cache: true
      - name: pixi run check
        run: pixi run check

  prod-env:
    name: prod env stays clean
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v4
      - uses: prefix-dev/setup-pixi@v0.8.0
        with:
          environments: prod
          cache: true
      # prod 只留运行期依赖：测试与 lint 工具泄漏进来会让“浏览器/服务端只装运行期”
      # 这条前提悄悄失效。
      #
      # 判据必须区分「工具不存在」和「环境求解/启动失败」：前两次实现把任何非 0
      # 都当成不存在，pixi 求解失败时断言会静默通过。所以只在退出码 127（pixi
      # 找不到命令）或输出明确是 ModuleNotFoundError / command not found 时才算
      # 通过；其余非 0 一律判 CI 失败。
      - name: pytest and ruff are absent
        run: |
          set +e
          set -uo pipefail
          failed=0
          for tool in pytest ruff; do
            output=$(pixi run -e prod "$tool" --version 2>&1)
            status=$?
            if [ "$status" -eq 0 ]; then
              echo "::error::$tool leaked into the prod environment (exit 0: $output)"
              failed=1
              continue
            fi
            if [ "$status" -ne 127 ] \
              && ! grep -qE "No module named|command not found" <<<"$output"; then
              echo "::error::could not prove $tool is absent — exit $status: $output"
              failed=1
            fi
          done
          exit "$failed"
      # 模块层面的同一断言：prod 里 import 不到 pytest / ruff，等价于工具没装进来，
      # 且不依赖 shell 对退出码的解读。
      - name: dev-only modules are not importable
        run: |
          pixi run -e prod python - <<'EOF'
          import importlib.util
          import sys

          leaked = [name for name in ("pytest", "ruff") if importlib.util.find_spec(name)]
          for name in leaked:
              print(f"::error::{name} is importable in the prod environment")
          sys.exit(1 if leaked else 0)
          EOF
      - name: runtime imports work
        run: PYTHONPATH=src pixi run -e prod python -c "import ggcore, numpy, skia; print('ggcore', ggcore.__version__)"

  cases-matrix:
    name: cases matrix
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v4
      # SIL-835：`cases matrix` 是最慢的 job（全量渲染 + 像素对拍），workflow 被触发
      # 不代表它必须跑：只改 tests/ 或纯 Python 门禁脚本的 PR 不会改变渲染产物。
      # 不引入第三方 action，直接用 git diff 判范围；PR 事件里 base SHA 一定可取。
      - name: scope — is the case matrix affected?
        id: scope
        run: |
          set -euo pipefail
          if [ "${{ github.event_name }}" != "pull_request" ]; then
            echo "run=true" >> "$GITHUB_OUTPUT"
            echo "not a pull_request — running the matrix"
            exit 0
          fi
          git fetch --no-tags --depth=1 origin "${{ github.event.pull_request.base.sha }}"
          changed=$(git diff --name-only FETCH_HEAD HEAD)
          echo "changed files:"; printf '%s\n' "$changed"
          if grep -qE '^(src/|docs/cases/|docs/spike/|tools/|web/|pixi\.toml$|pixi\.lock$|\.github/workflows/)' <<<"$changed"; then
            echo "run=true" >> "$GITHUB_OUTPUT"
          else
            echo "run=false" >> "$GITHUB_OUTPUT"
            echo "::notice::no src / docs-cases / tools / web / pixi change — skipping the case matrix"
          fi
      - uses: prefix-dev/setup-pixi@v0.8.0
        if: steps.scope.outputs.run == 'true'
        with:
          environments: default
          cache: true
      # 一、扫描 docs/cases 的三文件 case，渲染 + 比对，写 docs/cases/matrix.md
      #    与 .cases-matrix/report.md；有红 case 就直接非 0 退出（失败 case 名
      #    同时以 ::error 注解出现在 PR 的 Files changed 里）。
      - name: pixi run cases:matrix
        if: steps.scope.outputs.run == 'true'
        run: pixi run cases:matrix
      # 二、静态矩阵是入库产物：新增/删除 case 后必须把重生成的矩阵一起提交。
      - name: matrix.md is up to date
        if: steps.scope.outputs.run == 'true'
        run: git diff --exit-code -- docs/cases/matrix.md
      # 三、PR 上贴摘要：报告文件 + 失败 case 名（step summary 逐 job 保留）。
      - name: publish summary
        if: always() && steps.scope.outputs.run == 'true'
        run: |
          {
            echo "### 案例矩阵"
            echo
            if [ -f .cases-matrix/report.md ]; then
              cat .cases-matrix/report.md
            else
              echo "报告没生成：上一步在写报告前就失败了。"
            fi
          } >> "$GITHUB_STEP_SUMMARY"
      - uses: actions/upload-artifact@v4
        if: always() && steps.scope.outputs.run == 'true'
        with:
          name: cases-matrix
          path: |
            docs/cases/matrix.md
            .cases-matrix/
          if-no-files-found: warn
